{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/arcscan/:path*",
      "destination": "https://explorer.testnet.arc.io/api/v2/:path*"
    },
    {
      "source": "/arcstats/:path*",
      "destination": "https://explorer.testnet.arc.io/stats-service/api/v1/:path*"
    },
    {
      "source": "/((?!assets/|arcscan/|arcstats/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
