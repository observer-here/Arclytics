# Local wrangler: Vite proxies /api to 127.0.0.1:8787
VITE_API_URL=/api

# Production / Vercel — Cloudflare Worker
# VITE_API_URL=https://arclytics-api.dartajamul108.workers.dev

# Optional ArcScan / RPC overrides
# VITE_ARCSCAN_BASE_URL=https://testnet.arcscan.app/api/v2
# VITE_ARCSCAN_STATS_URL=https://testnet.arcscan.app/stats-service/api/v1
# VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
# VITE_ARC_WS_URL=wss://rpc.testnet.arc.network

# Ask Arclytics — put in backend/.dev.vars (gitignored)
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Ingest local D1
# API_URL=http://127.0.0.1:8787 pnpm ingest:full

# Magic Labs — publishable key in apps/web/.env.local
# VITE_MAGIC_PUBLISHABLE_KEY=pk_live_...
# Secret key in backend/.dev.vars
# MAGIC_SECRET_KEY=sk_live_...
