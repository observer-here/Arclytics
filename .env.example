# Local dev (default) — wrangler dev on :8787, proxied by Vite at /api
VITE_API_URL=/api

# Production (Vercel) — Cloudflare Workers API
# VITE_API_URL=https://arclytics-api.dartajamul108.workers.dev

# Optional overrides
# VITE_ARCSCAN_BASE_URL=https://testnet.arcscan.app/api/v2
# VITE_ARCSCAN_STATS_URL=https://testnet.arcscan.app/stats-service/api/v1
# VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
# VITE_ARC_WS_URL=wss://rpc.testnet.arc.network

# Cloudflare Workers deploy (shell only — never commit)
# CLOUDFLARE_API_TOKEN=your_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id

# Optional: protect POST /v1/ingest on production
# wrangler secret put INGEST_SECRET
# INGEST_SECRET=your_secret

# Deploy + ingest production API
# pnpm deploy:api

# Ingest local or remote API
# API_URL=http://127.0.0.1:8787 pnpm ingest:full
# API_URL=https://arclytics-api.dartajamul108.workers.dev pnpm ingest:full
